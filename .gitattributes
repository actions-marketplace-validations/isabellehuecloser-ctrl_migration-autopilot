# Normalize line endings to LF so the committed bundle is reproducible across
# Windows/Linux. Without this, a `npm run build` committed from Windows could flip
# dist/ to CRLF and break the CI "dist up to date" check (which diffs a fresh
# Linux LF build against the committed bundle).
* text=auto eol=lf

# Generated bundle: keep LF, hide from diffs and language stats.
dist/** linguist-generated=true -diff
*.min.js -diff
package-lock.json -diff linguist-generated=true

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.ico binary
